# ══════════════════════════════════════════════════════════════════
# ExamHelper AI — Environment Variables
# ══════════════════════════════════════════════════════════════════
#
# Copy this file to .env.local and fill in your values:
#   cp .env.example .env.local          (macOS/Linux)
#   Copy-Item .env.example .env.local   (Windows PowerShell)
#
# All variables are optional. The app runs in demo mode when no
# keys are configured.
#
# Full documentation: docs/ENVIRONMENT.md
# ══════════════════════════════════════════════════════════════════

# ── Groq API Keys ────────────────────────────────────────────────
# Get free keys at https://console.groq.com → API Keys
# Each task has its own key pool for rate-limit isolation.

# Notes generation (up to 3 keys)
NEXT_PUBLIC_GROQ_NOTES_KEY_1=
NEXT_PUBLIC_GROQ_NOTES_KEY_2=
NEXT_PUBLIC_GROQ_NOTES_KEY_3=

# Flashcard + diagram generation (up to 2 keys)
NEXT_PUBLIC_GROQ_FLASHCARD_KEY_1=
NEXT_PUBLIC_GROQ_FLASHCARD_KEY_2=

# Quiz generation (up to 2 keys)
NEXT_PUBLIC_GROQ_QUIZ_KEY_1=
NEXT_PUBLIC_GROQ_QUIZ_KEY_2=

# Course Tutor generation (up to 2 keys - falls back to notes keys if empty)
NEXT_PUBLIC_GROQ_TUTOR_KEY_1=
NEXT_PUBLIC_GROQ_TUTOR_KEY_2=

# ── Supabase Authentication (optional) ───────────────────────────
# Get from https://supabase.com → Settings → API
# If omitted, auth falls back to a demo user.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
